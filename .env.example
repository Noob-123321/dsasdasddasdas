# App
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
# For a tunnel/proxy, set the public origin, e.g. https://your-domain.example
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///./data/tvs.db
# PostgreSQL production example:
# DATABASE_URL=postgresql+psycopg://tvs:password@postgres:5432/tvs
REDIS_URL=redis://127.0.0.1:6379/0

# Token encryption. Leave blank for a local key in data/token.key.
# In production provide a secret-manager value or TOKEN_ENCRYPTION_KEY_FILE.
TOKEN_ENCRYPTION_KEY=
# BOOTSTRAP_ADMIN_TOKEN=TVS_<128 random characters>
BOOTSTRAP_ADMIN_TOKEN=

# Poller
POLLER_ENABLED=1
POLL_INTERVAL_SECONDS=60
POLL_BATCH=200
# Use gql for real Twitch data. Set demo only for a deterministic local smoke test.
TWITCH_SOURCE=gql
# TWITCH_SOURCE=demo
TWITCH_TIMEOUT_SECONDS=15

# Detection data collection. The chatter roster is a randomised sample of at most
# 100 logins, so polling it every 10th poll costs one call and loses nothing.
CHATTER_ROSTER_EVERY=10
# Re-enrich cached chatter accounts (users(logins:)) at most once per N hours.
CHATTER_ENRICH_HOURS=6.0

# Browser sessions
SESSION_DAYS=30
COOKIE_SECURE=0
MAX_JSON_BYTES=131072
TRUSTED_PROXIES=

# Optional Telegram alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
